# ---------------------------------------------------------------------------
# EUTERPIA — артефакты сборки и локальные данные.
# ---------------------------------------------------------------------------

# Nim
nimcache/
*.exe
*.dll
*.so
*.dylib
*.o
*.a
*.obj
*.lib
*.pdb

# Бинарники тестов ядра (см. euterpia.nimble: unitBin / intBin)
build/

# Локальные записи и реалтайм-скретчи
*.wav
*.aiff
*.flac
*.ogg
*.mp3
*.mid
rt_scratch*
*.log

# Кэш waveform_cache по умолчанию
.waveform_cache/

# Иде-специфичное
.vscode/
.idea/
*.swp
*~

# Каталог Agent Skills, который материализует окружение редактора.
# К ядру EUTERPIA не относится и в репозиторий не попадает.
.agents/

# Тестовые аудио-фикстуры кодеков (#10): маленькие сэмплы (tone.*) —
# часть теста, поэтому им разрешено лежать в git вопреки общему запрету
# на аудио выше. Скоуп узкий: только tests/fixtures/.
!tests/fixtures/
!tests/fixtures/*.wav
!tests/fixtures/*.flac
!tests/fixtures/*.mp3
!tests/fixtures/*.ogg
!tests/fixtures/*.aiff

# Служебный вывод фоновых запусков (nohup, nimble - логи в /tmp).
nohup.out
